{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.fps.shotgun_12g.actions": {
   "initial_state": "default",
   "states": {
    "default": {
     "on_entry": [
      "v.clip = 0;"
     ],
     "transitions": [
      {
       "draw": "q.property('fps:anim') == 1 && q.property('fps:seq') != (v.seq ?? 0)"
      },
      {
       "inspect": "q.property('fps:anim') == 4 && q.property('fps:seq') != (v.seq ?? 0)"
      },
      {
       "cycle": "q.property('fps:anim') == 5 && q.property('fps:seq') != (v.seq ?? 0)"
      },
      {
       "shell_start": "q.property('fps:anim') == 6 && q.property('fps:seq') != (v.seq ?? 0)"
      },
      {
       "shell_loop": "q.property('fps:anim') == 7 && q.property('fps:seq') != (v.seq ?? 0)"
      },
      {
       "shell_end": "q.property('fps:anim') == 8 && q.property('fps:seq') != (v.seq ?? 0)"
      }
     ]
    },
    "draw": {
     "animations": [
      "draw"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    },
    "inspect": {
     "animations": [
      "inspect"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    },
    "cycle": {
     "animations": [
      "pump"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    },
    "shell_start": {
     "animations": [
      "reload_start"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    },
    "shell_loop": {
     "animations": [
      "reload_loop"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    },
    "shell_end": {
     "animations": [
      "reload_end"
     ],
     "on_entry": [
      "v.clip = 1;",
      "v.seq = q.property('fps:seq');"
     ],
     "transitions": [
      {
       "default": "q.all_animations_finished || q.property('fps:seq') != v.seq"
      }
     ],
     "blend_transition": 0.08
    }
   }
  },
  "controller.animation.fps.shotgun_12g.fire": {
   "initial_state": "init",
   "states": {
    "init": {
     "transitions": [
      {
       "w0": "q.property('fps:shot') == 0"
      },
      {
       "w1": "q.property('fps:shot') == 1"
      }
     ]
    },
    "w0": {
     "transitions": [
      {
       "f1": "q.property('fps:shot') == 1"
      }
     ]
    },
    "w1": {
     "transitions": [
      {
       "f0": "q.property('fps:shot') == 0"
      }
     ]
    },
    "f0": {
     "animations": [
      "fire"
     ],
     "transitions": [
      {
       "f1": "q.property('fps:shot') == 1"
      }
     ]
    },
    "f1": {
     "animations": [
      "fire"
     ],
     "transitions": [
      {
       "f0": "q.property('fps:shot') == 0"
      }
     ]
    }
   }
  }
 }
}