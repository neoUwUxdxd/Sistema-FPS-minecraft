{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "fps:rifle_762",
   "item": {
    "fps:rifle_762": "query.is_owner_identifier_any('minecraft:player')"
   },
   "materials": {
    "default": "entity_alphatest",
    "glass": "entity_alphablend",
    "enchanted": "entity_alphatest_glint"
   },
   "textures": {
    "default": "textures/fps/guns/rifle_762",
    "enchanted": "textures/misc/enchanted_item_glint"
   },
   "geometry": {
    "default": "geometry.fps.rifle_762"
   },
   "animations": {
    "procedural": "animation.fps.rifle_762.procedural",
    "arms_idle": "animation.fps.rifle_762.arms_idle",
    "actions": "controller.animation.fps.rifle_762.actions",
    "fire_ctrl": "controller.animation.fps.rifle_762.fire",
    "draw": "animation.fps.rifle_762.draw",
    "fire": "animation.fps.rifle_762.fire",
    "reload": "animation.fps.rifle_762.reload",
    "reload_empty": "animation.fps.rifle_762.reload_empty",
    "inspect": "animation.fps.rifle_762.inspect"
   },
   "scripts": {
    "pre_animation": [
     "v.dt = math.clamp(q.delta_time, 0, 0.05);",
     "v.busy = v.clip;",
     "v.ads = math.clamp(v.ads + ((q.is_sneaking && !v.busy && !q.is_sprinting) ? v.dt / 0.27 : -v.dt * 1.3 / 0.27), 0, 1);",
     "v.e = v.ads * v.ads * (3 - 2 * v.ads);",
     "v.spr = math.clamp(v.spr + ((q.is_sprinting && v.ads < 0.1 && !v.busy) ? v.dt * 5 : -v.dt * 6), 0, 1);",
     "v.se = v.spr * v.spr * (3 - 2 * v.spr);",
     "v.shot = q.property('fps:shot');",
     "v.trig = v.ready && (v.last_shot != v.shot);",
     "v.last_shot = v.shot;",
     "v.ready = 1;",
     "v.kf = 1.25 * (1 - 0.45 * v.e);",
     "v.kbv = v.kbv + (v.trig ? 1.1 * v.kf : 0);",
     "v.kbv = v.kbv + (-260 * v.kb - 17.7 * v.kbv) * v.dt;",
     "v.kb = v.kb + v.kbv * v.dt;",
     "v.kpv = v.kpv + (v.trig ? 70 * v.kf * math.random(0.8, 1.2) : 0);",
     "v.kpv = v.kpv + (-220 * v.kp - 13.3 * v.kpv) * v.dt;",
     "v.kp = v.kp + v.kpv * v.dt;",
     "v.kyv = v.kyv + (v.trig ? 25 * v.kf * math.random(-1, 1) : 0);",
     "v.kyv = v.kyv + (-200 * v.ky - 14.1 * v.kyv) * v.dt;",
     "v.ky = v.ky + v.kyv * v.dt;",
     "v.krv = v.krv + (v.trig ? 45 * v.kf * math.random(-1, 1) : 0);",
     "v.krv = v.krv + (-180 * v.kr - 10.7 * v.krv) * v.dt;",
     "v.kr = v.kr + v.krv * v.dt;",
     "v.scoped = 0;"
    ],
    "animate": [
     "procedural",
     {
      "arms_idle": "1 - v.clip"
     },
     "actions",
     "fire_ctrl"
    ]
   },
   "sound_effects": {
    "!eject": "fps.!eject",
    "charge_back": "fps.charge_back",
    "charge_release": "fps.charge_release",
    "gun_draw": "fps.gun_draw",
    "gun_handle": "fps.gun_handle",
    "mag_in": "fps.mag_in",
    "mag_out": "fps.mag_out"
   },
   "particle_effects": {
    "casing": "fps:casing_rifle",
    "flash": "fps:muzzle_flash",
    "smoke": "fps:muzzle_smoke"
   },
   "render_controllers": [
    "controller.render.fps.gun"
   ]
  }
 }
}